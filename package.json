{
  "name": "mateoolarte.com",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "next build --experimental-app-only",
    "start": "next start",
    "lint:js": "oxlint",
    "lint:js:fix": "oxlint --fix",
    "lint:css": "stylelint '**/*.css'",
    "lint": "bun run lint:js && bun run lint:css",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "analyze": "ANALYZE=true bun run build",
    "security": "bun audit --audit-level=critical",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.1.16",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.2",
    "next": "16.2.9",
    "next-intl": "4.13.0",
    "posthog-js": "1.386.8",
    "posthog-node": "5.37.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@next/bundle-analyzer": "16.2.9",
    "@playwright/test": "1.61.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@vitejs/plugin-react": "5.2.0",
    "eslint-plugin-sonarjs": "4.0.3",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.7",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "stylelint": "17.13.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.9"
  }
}
